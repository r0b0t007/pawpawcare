# Frontend
frontend/node_modules/
frontend/.expo/
frontend/dist/
frontend/web-build/
# Backend
backend/__pycache__/
backend/*.pyc
backend/.venv/
backend/venv/
backend/*.db
backend/*.sqlite3

# Root node_modules and .expo (leftovers from before the app moved to frontend/)
node_modules/
.expo/

# Credentials — never commit these
google-service-account.json
frontend/google-service-account.json
*.p8
*.p12
*.mobileprovision

# Environment variables
.env
.env.local
frontend/.env.local
backend/.env

# AI editor / assistant tool directories (personal, not team config)
.agents/
# .claude/ is personal by default, but a few files are shared team config.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/hooks/
.junie/
.kiro/
.qwen/
.windsurf/
skills-lock.json

# OS
.DS_Store
Thumbs.db

# Netlify local state
website/.netlify/

# Signing credentials & secrets — NEVER commit
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
google-service-account.json

# Netlify CLI artifact at the repo root (can acquire auth state)
/.netlify/

# Cloudflare Wrangler local dev state
.wrangler/

# Cloudflare Pages Functions build output (regenerated by `wrangler pages
# functions build` before every deploy — see docs/deploy-website-cloudflare.md)
website/_worker.js/
website/_routes.json
