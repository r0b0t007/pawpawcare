{
  "expo": {
    "name": "PawPawCare",
    "slug": "r0b0t0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/598e341a-f9a8-4117-a609-fcafc34e1dcd"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pawpawcare.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pawpawcare.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fdf8f4"
      }
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PawPawCare to access your photos to set pet pictures and share posts."
        }
      ],
      "expo-localization",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#fff8f4"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.493303263143-81gcusogeirf5gmjj5spk4b17v7m5hv6"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "pawpawcare",
          "project": "pawpawcare-app"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "598e341a-f9a8-4117-a609-fcafc34e1dcd"
      }
    },
    "owner": "ahmedchioua"
  }
}
