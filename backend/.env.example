APP_NAME=PawPawCare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ── PawPawCare API settings ──────────────────────────────────────────────
# JWT signing secret — CHANGE THIS in production.
SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGO=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# CORS — comma-separated origins. Leave unset for a wildcard (dev only).
# ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — MySQL/MariaDB by default (matches the XAMPP dev setup).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pawpawcare
DB_USERNAME=root
DB_PASSWORD=

# No browser sessions or queues are used by this API.
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
