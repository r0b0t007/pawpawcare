APP_NAME=PawPawCare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ── PawPawCare API settings ──────────────────────────────────────────────
# JWT signing secret — CHANGE THIS in production.
SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGO=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# CORS — comma-separated origins. Leave unset for a wildcard (dev only).
# ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Production: LOG_STACK=single,sentry (error+ logs become Sentry events)
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — MySQL/MariaDB by default (matches the XAMPP dev setup).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pawpawcare
DB_USERNAME=root
DB_PASSWORD=

# No browser sessions or queues are used by this API.
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Password-reset and verification codes. `log` writes them to
# storage/logs/laravel.log (local dev only). Production sends over SMTP through
# the cPanel mailbox — see docs/deploy-backend.md §5.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Where in-app "Contact us" messages are forwarded (unset: stored only).
SUPPORT_INBOX=

# AI document intake (vault record extraction)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Alternative extraction provider (default: anthropic). Set provider to
# openai-compatible and point at any Chat Completions vision endpoint.
EXTRACTION_PROVIDER=anthropic
EXTRACTION_BASE_URL=
EXTRACTION_MODEL=
EXTRACTION_API_KEY=

# Social sign-in (Google / Apple). GOOGLE_WEB_CLIENT_ID is the *Web* OAuth
# client ID from Google Cloud Console — it's the audience of the ID token the
# app sends (the mobile app's google-signin is configured with this same value
# as its webClientId). APPLE_BUNDLE_ID is the app's bundle identifier, the
# audience of the Sign in with Apple identity token. Leave GOOGLE_WEB_CLIENT_ID
# blank to disable Google sign-in (the endpoint returns 503 until it's set).
GOOGLE_WEB_CLIENT_ID=
APPLE_BUNDLE_ID=com.pawpawcare.app

# Sentry error monitoring (inert when empty). See config/sentry.php.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Server-side product analytics (PostHog US). Empty key = disabled.
# The personal API key needs only the person:write scope (account purge).
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# RevenueCat subscriptions. WEBHOOK_AUTH = the exact Authorization header value
# set on the RevenueCat webhook (long random string). Empty = webhook disabled.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=
# Our user ids (comma-separated) whose sandbox purchases count — App Review.
REVENUECAT_SANDBOX_USER_IDS=

# Subscription gating (config/entitlements.php) — everything off by default.
PAYWALL_ENABLED=false
SUBSCRIPTIONS_VISIBLE=off
PAYWALL_GRANDFATHER_BEFORE=
GATE_AI_EXTRACTION=false
GATE_CARE_LINKS=false
FREE_AI_EXTRACTIONS=0

# Nightly encrypted backups to Cloudflare R2 (docs/backups.md). Until all of
# these are set, the scheduler logs "Backups are not configured" every night.
BACKUP_DISK=backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_R2_BUCKET=pawpawcare-backups
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Uploads on R2 go into every archive; above this the uploads are left out with an error (docs/backups.md).
# BACKUP_UPLOADS_MAX_MB=200
# Each account's documents across all its pets; keep well under the line above.
# DOCUMENTS_MAX_MB_PER_ACCOUNT=100
# DOCUMENTS_MAX_PER_ACCOUNT=500

# Where uploads live (docs/uploads-r2.md). Local disks by default; production
# uses r2-media + r2-documents, then runs `php artisan uploads:migrate` once.
# The R2 token is a separate one from the backups token, scoped to these two
# buckets (Object Read & Write).
UPLOADS_PUBLIC_DISK=public
UPLOADS_PRIVATE_DISK=local
UPLOADS_R2_ENDPOINT=
UPLOADS_R2_ACCESS_KEY_ID=
UPLOADS_R2_SECRET_ACCESS_KEY=
UPLOADS_R2_MEDIA_BUCKET=pawpawcare-media
UPLOADS_R2_DOCUMENTS_BUCKET=pawpawcare-documents
# Permanent once set: every stored image url contains it.
MEDIA_URL=
# Never accepted as an "external" image host (default media.pawpawcare.app).
# MEDIA_HOST=
