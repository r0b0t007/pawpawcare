# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pawpawcare
# For local dev without Docker, use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./pawpawcare.db

# JWT
SECRET_KEY=change-me-to-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,exp://localhost:19000

# Environment
ENVIRONMENT=development
